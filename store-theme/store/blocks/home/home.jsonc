{
  "store.home": {
    "blocks": [
      "list-context.image-list#demo",
      

      /* You can make references to blocks defined in other files.
       * For example, `flex-layout.row#deals` is defined in the `deals.json` file. */
     "flex-layout.row#quick-filters",
     "black-friday-banner",
     
     "flex-layout.row#deals",
      "__fold__",
      "rich-text#shelf-title",
      "flex-layout.row#shelf",
      "info-card#home",
      "rich-text#question",
      "rich-text#link",
      "newsletter"
    ]
  },
 
  "list-context.image-list#demo": {
    "children": ["slider-layout#demo-images"],
    "props": {
      "height": 200,
      "preload": true,
      "images": [
        {
          "image": "https://partnersigrowdev.vtexassets.com/assets/vtex.file-manager-graphql/images/d45c94a8-f70b-4b22-babd-868b5e6fc84b___44a53fb9a76cb805df771bdaf13e298f.png",
          "mobileImage": "https://partnersigrowdev.vtexassets.com/assets/vtex.file-manager-graphql/images/92c2b66d-613b-4af8-ad45-d63642a7aabc___217bf298d7e3d5462d33593dc0a53f75.png",
          "description": "Coleção Primavera"
        }
      ]
    }
  },
  "slider-layout#demo-images": {
    "props": {
      "itemsPerPage": {
        "desktop": 1,
        "tablet": 1,
        "phone": 1
      },
      "infinite": true,
      "showNavigationArrows": "desktopOnly",
      "showPaginationDots": "always",
      "fullWidth": true,
      "blockClass": "mainBannerCarousel"
    }
  },

  

  "rich-text#shelf-title": {
    "props": {
      "text": "## Summer",
      "blockClass": "shelfTitle"
    }
  },
  "flex-layout.row#shelf": {
    "children": ["list-context.product-list#demo1"]
  },
  "list-context.product-list#demo1": {
    "blocks": ["product-summary.shelf"],
    "children": ["slider-layout#demo-products"],
    "props": {
      "orderBy": "OrderByTopSaleDESC"
    }
  },
  "slider-layout#demo-products": {
    "props": {
      "itemsPerPage": {
        "desktop": 4,
        "tablet": 3,
        "phone": 1
      },
      "infinite": true,
      "fullWidth": false,
      "blockClass": "shelf"
    }
  },

  "info-card#home": {
    "props": {
      "id": "info-card-home",
      "isFullModeStyle": false,
      "textPosition": "left",
      "imageUrl": "https://storecomponents.vteximg.com.br/arquivos/banner-infocard2.png",
      "headline": "Clearance Sale",
      "callToActionText": "DISCOVER",
      "callToActionUrl": "/sale/d",
      "blockClass": "info-card-home",
      "textAlignment": "center"
    }
  },

  "rich-text#question": {
    "props": {
      "text": "**This is an example store built using the VTEX platform.\nWant to know more?**",
      "blockClass": "question"
    }
  },

  "rich-text#link": {
    "props": {
      "text": "\n**Reach us at**\nwww.vtex.com.br",
      "blockClass": "link"
    }
  },

  "flex-layout.row#quick-filters": {
  "props": {
    "blockClass": "quickFiltersRow",
    "horizontalAlign": "center",
    "verticalAlign": "center",
    "preventHorizontalStretch": true,
    "fullWidth": true
  },
  "children": [
    "rich-text#filter-category",
    "rich-text#filter-subcategory",
    "rich-text#filter-color",
    "rich-text#filter-material",
    "rich-text#filter-size",
    "rich-text#filter-price"
  ]
},

"rich-text#filter-category": {
  "props": {
    "text": "CATEGORIA ∨",
    "blockClass": "quickFilterItem"
  }
},
"rich-text#filter-subcategory": {
  "props": {
    "text": "SUBCATEGORIA ∨",
    "blockClass": "quickFilterItem"
  }
},
"rich-text#filter-color": {
  "props": {
    "text": "COR ∨",
    "blockClass": "quickFilterItem"
  }
},
"rich-text#filter-material": {
  "props": {
    "text": "MATERIAL ∨",
    "blockClass": "quickFilterItem"
  }
},
"rich-text#filter-size": {
  "props": {
    "text": "TAMANHO ∨",
    "blockClass": "quickFilterItem"
  }
},
"rich-text#filter-price": {
  "props": {
    "text": "FAIXAS DE PREÇO ∨",
    "blockClass": "quickFilterItem"
  }
}
}
